# install.sh generates MCP_TOKEN only when creating a NEW .env.
TYPESAFE_API_KEY=
MCP_TOKEN=
MODEL=jev-1.14.0
# Container listens internally; published host port stays loopback-only.
HOST=0.0.0.0
PORT=8765
MCP_PORT=8765
ALLOWED_HOSTS=localhost,127.0.0.1
DB_PATH=/data/history.sqlite3
TIMEOUT_SECONDS=20
MIN_CONFIDENCE=0.8
MIN_PROBABILITY=0.9
NOUL_REJECT_THRESHOLD=0.1
SCORE_MIN_FRACTION=0.75
MAX_QUESTIONS=32
MAX_INPUT_BYTES=65536
# Rates checked 2026-11-25; estimates, not billing data. Review on model changes.
INPUT_USD_PER_MILLION=0.042
OUTPUT_USD_PER_MILLION=0
RESERVED_INPUT_TOKENS=65536
RESERVED_OUTPUT_TOKENS=65536
DAILY_BUDGET_USD=1
MAX_REQUEST_COST_USD=0.01
MAX_DAILY_CALLS=1000
COMPOSE_PROJECT_NAME=jev-decision
JEV_IMAGE=jev-decision-mcp:local
JEV_DATA_VOLUME=jev-decision-data
